generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String    @id // Clerk ki user id (Inngest webhook se aayegi)
  name      String
  email     String    @unique
  image     String?
  clinic    Clinic?
  bookings  Booking[]
  createdAt DateTime  @default(now())
}

model Clinic {
  id          String    @id @default(cuid())
  name        String
  address     String
  city        String
  email       String
  phone       String
  logo        String?
  clinicImage String[]  @default([])
  isApproved  Boolean   @default(false)
  userId      String    @unique
  user        User      @relation(fields: [userId], references: [id])
  doctors     Doctor[]
  bookings    Booking[]
  createdAt   DateTime  @default(now())

  @@index([city, isApproved])
}

enum BookingStatus {
  PENDING
  COMPLETED
  CANCELLED
  SKIPPED
}

enum Weekday {
  MON
  TUE
  WED
  THU
  FRI
  SAT
  SUN
}

// Specialty ab database table nahi hai. List src/data/specialties.json mein hai,
// aur Doctor sirf uski slug (jaise "dentist") store karta hai.
model Doctor {
  id            String           @id @default(cuid())
  name          String
  image         String?
  description   String?
  isActive      Boolean          @default(true)
  specialtySlug String
  clinicId      String
  clinic        Clinic           @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  schedules     DoctorSchedule[]
  slots         TimeSlot[]
  createdAt     DateTime         @default(now())

  @@index([clinicId])
  @@index([specialtySlug])
}

// Doctor kis din, kis time baithta hai (hafte ka repeat hone wala schedule)
model DoctorSchedule {
  id           String  @id @default(cuid())
  doctorId     String
  doctor       Doctor  @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  day          Weekday
  startTime    String // "10:00"
  endTime      String // "13:00"
  tokenMinutes Int     @default(15)

  @@unique([doctorId, day, startTime])
  @@index([doctorId])
}

model TimeSlot {
  id           String    @id @default(cuid())
  doctorId     String
  doctor       Doctor    @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  date         DateTime  @db.Date
  startTime    String // "10:00"
  endTime      String // "13:00"
  tokenMinutes Int       @default(15)
  maxTokens    Int
  isClosed     Boolean   @default(false)
  bookings     Booking[]

  @@unique([doctorId, date, startTime])
  @@index([doctorId, date])
}

model Booking {
  id          String        @id @default(cuid())
  tokenNumber Int
  status      BookingStatus @default(PENDING)
  patientName String?
  userId      String
  user        User          @relation(fields: [userId], references: [id])
  clinicId    String
  clinic      Clinic        @relation(fields: [clinicId], references: [id])
  slotId      String
  slot        TimeSlot      @relation(fields: [slotId], references: [id], onDelete: Cascade)
  createdAt   DateTime      @default(now())
  completedAt DateTime?

  @@unique([slotId, tokenNumber])
  @@index([userId])
  @@index([clinicId, status])
  @@index([slotId, status])
}
